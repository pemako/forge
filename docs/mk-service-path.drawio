        <mxCell id="20" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;cfg, _ := config.Load()   // YAML + env vars + hot reload&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;log, _ := logger.New(logger.WithConfig(cfg))&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#059669;&quot;&gt;→ cfg and log injected into every downstream component&lt;/font&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.2;html=1;align=left;spacingLeft=14;spacingTop=10;spacingBottom=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="130" y="112" width="460" height="78" as="geometry"/></mxCell>
