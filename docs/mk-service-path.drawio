        <mxCell id="18" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;color:#2563EB;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Config + Logger&lt;/font&gt;&lt;/b&gt;" style="rounded=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.5;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="76" width="460" height="36" as="geometry"/></mxCell>
