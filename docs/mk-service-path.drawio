        <mxCell id="24" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;tp, _ := tracing.New(tracing.WithConfig(cfg), tracing.WithLogger(log))&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;mp, _ := metric.New(metric.WithConfig(cfg), metric.WithLogger(log))&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#059669;&quot;&gt;→ implements app.Lifecycle → Init() before start, Shutdown() after stop&lt;/font&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1.2;html=1;align=left;spacingLeft=14;spacingTop=10;spacingBottom=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="130" y="240" width="460" height="78" as="geometry"/></mxCell>
