        <mxCell id="28" value="&lt;font style=&quot;font-size:9px;color:#059669;&quot;&gt;&lt;b&gt;app.WithMigration+Closer&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="482" y="341" width="100" height="18" as="geometry"/></mxCell>
        <mxCell id="29" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;dbMgr, _ := database.New(database.WithConfig(cfg), ...)&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;database.Register(&amp;quot;default&amp;quot;, dbMgr)&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;cacheMgr, _ := cache.New(cache.WithConfig(cfg), ...)&lt;/font&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1F2937;&quot;&gt;cache.Register(&amp;quot;default&amp;quot;, cacheMgr)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#059669;&quot;&gt;→ dbMgr: WithMigration  ·  cacheMgr: WithCloser&lt;/font&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.2;html=1;align=left;spacingLeft=14;spacingTop=10;spacingBottom=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="130" y="368" width="460" height="118" as="geometry"/></mxCell>
